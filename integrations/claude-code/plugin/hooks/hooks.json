{
  "description": "bogo hooks. Both only act in a repo that has .bogo/, never block, never call a model, and exit quietly when the bogo binary is missing. Turn them off with BOGO_HOOKS=off or a .bogo/hooks.off file.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh",
            "args": [],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/edit-warn.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
